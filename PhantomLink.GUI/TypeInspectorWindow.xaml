<Window x:Class="PhantomLink.GUI.TypeInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Type Inspector" Height="720" Width="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TypeTitle" FontSize="16" FontWeight="Bold"/>
            <TextBlock x:Name="TypeSubtitle" Foreground="Gray"/>
        </StackPanel>

        <TabControl Grid.Row="1" x:Name="Tabs">
            <TabItem Header="Instances">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Enumerate" Width="110" Margin="0,0,10,0" Click="EnumerateInstances_Click"/>
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="InstanceFilterBox" Width="260" TextChanged="InstanceFilterBox_TextChanged"/>
                        <TextBlock x:Name="InstanceCountText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="InstancesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="InstancesGrid_SelectionChanged">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Pin Object" Click="PinSelectedInstance_Click"/>
                                <MenuItem Header="Unpin Object" Click="UnpinSelectedInstance_Click"/>
                                <Separator/>
                                <MenuItem Header="Dump to JSON" Click="DumpSelectedInstance_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" x:Name="InstancesStatus" Margin="0,6,0,6" Foreground="Gray"/>

                    <TabControl Grid.Row="3" x:Name="InstanceTabs">
                        <TabItem Header="Fields">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Load" Width="100" Margin="0,0,10,0" Click="LoadInstanceFields_Click"/>
                                    <Button Content="Update Selected" Width="140" Click="UpdateInstanceField_Click"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1" x:Name="InstanceFieldsGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" KeyDown="InstanceFieldsGrid_KeyDown" MouseDoubleClick="InstanceFieldsGrid_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Watch Value" Click="WatchInstanceField_Click"/>
                                            <MenuItem Header="Copy Full Path" Click="CopyInstanceFieldPath_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="220" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" x:Name="InstanceFieldsStatus" Margin="0,6,0,0" Foreground="Gray"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Properties">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Load" Width="100" Margin="0,0,10,0" Click="LoadInstanceProperties_Click"/>
                                    <Button Content="Set Selected" Width="120" Click="SetInstanceProperty_Click"/>
                                    <Button Content="Update Selected" Width="140" Margin="10,0,0,0" Click="UpdateInstanceProperty_Click"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1" x:Name="InstancePropertiesGrid" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" KeyDown="InstancePropertiesGrid_KeyDown" MouseDoubleClick="InstancePropertiesGrid_MouseDoubleClick">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Watch Value" Click="WatchInstanceProperty_Click"/>
                                            <MenuItem Header="Copy Full Path" Click="CopyInstancePropertyPath_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="220" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Read" Binding="{Binding CanRead}" Width="55" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Write" Binding="{Binding CanWrite}" Width="55" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" x:Name="InstancePropertiesStatus" Margin="0,6,0,0" Foreground="Gray"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Methods">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Load" Width="100" Margin="0,0,10,0" Click="LoadInstanceMethods_Click"/>
                                    <TextBlock Text="Parameters (CSV):" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                    <TextBox x:Name="InstanceInvokeArgsBox" Width="320" Margin="0,0,10,0"/>
                                    <Button Content="Invoke Selected" Width="140" Click="InvokeInstanceMethod_Click"/>
                                </StackPanel>

                                <DataGrid Grid.Row="1" x:Name="InstanceMethodsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Signature" Binding="{Binding Signature}" Width="*" />
                                        <DataGridCheckBoxColumn Header="Public" Binding="{Binding IsPublic}" Width="60"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Grid.Row="2" x:Name="InstanceMethodsStatus" Margin="0,6,0,0" Foreground="Gray"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Close" Width="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
