<Window x:Class="PhantomLink.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhantomLink.GUI"
        mc:Ignorable="d"
        Title="PhantomLink" Height="740" Width="1120"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="PL.NavigationTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource PL.TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{DynamicResource PL.CornerRadiusMd}"
                                Margin="8,8"
                                Padding="10,12"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Background="Transparent" CornerRadius="{DynamicResource PL.CornerRadiusSm}"/>
                                <ContentPresenter Grid.Column="2"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#222A33"/>
                                <Setter Property="Foreground" Value="{DynamicResource PL.TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PL.SurfaceBrush}"/>
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource PL.AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PL.TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PL.NavigationTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource PL.SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource PL.BorderBrush}"
                                    BorderThickness="1,1,0,1"
                                    CornerRadius="8,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalContentAlignment="Top"
                                              Padding="0,6,0,6">
                                    <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" VerticalAlignment="Top"/>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource PL.SurfaceBrush}"
                                    BorderBrush="{DynamicResource PL.BorderBrush}"
                                    BorderThickness="0,1,1,1"
                                    CornerRadius="0,8,8,0"
                                    Padding="12">
                                <ContentPresenter ContentSource="SelectedContent" KeyboardNavigation.TabIndex="2"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource PL.SurfaceAltBrush}"
                BorderBrush="{DynamicResource PL.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource PL.CornerRadiusMd}"
                Padding="14"
                Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="PhantomLink" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="External runtime toolkit with MelonLoader integration"
                               Foreground="{DynamicResource PL.TextSecondaryBrush}"
                               FontSize="12"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Width="90"
                            Padding="10,4"
                            Click="RefreshButton_Click"/>
                    <Button Content="Scene Explorer"
                            Width="120"
                            Padding="10,4"
                            Margin="10,0,0,0"
                            Click="OpenRealtimeSceneExplorer_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        
        <!-- Main Content -->
        <TabControl Grid.Row="1" Style="{StaticResource PL.NavigationTabControlStyle}">
            <TabControl.Resources>
                <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource PL.NavigationTabItemStyle}"/>
            </TabControl.Resources>
            <TabItem Header="Game Controls">
                <local:GameControlsView x:Name="GameControls"/>
            </TabItem>
            <TabItem Header="Hierarchy">
                <local:HierarchyBrowserView/>
            </TabItem>
            <TabItem Header="Object Finder">
                <local:ObjectFinderView/>
            </TabItem>
            <TabItem Header="Scene Browser">
                <local:SceneBrowserView/>
            </TabItem>
            <TabItem Header="Scene Hierarchy">
                <local:SceneHierarchyView/>
            </TabItem>
            <TabItem Header="Factory Browser">
                <local:FactoryMethodBrowserView/>
            </TabItem>
            <TabItem Header="Types">
                <local:TypesView/>
            </TabItem>
            <TabItem Header="Classes">
                <local:ClassesView/>
            </TabItem>
            <TabItem Header="Method Browser">
                <local:MethodBrowserView/>
            </TabItem>
            <TabItem Header="Properties">
                <local:PropertiesView/>
            </TabItem>
            <TabItem Header="Field Editor">
                <local:FieldEditorView/>
            </TabItem>
            <TabItem Header="Watches">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Remove Selected" Width="140" Margin="0,0,10,0" Click="RemoveWatch_Click"/>
                        <Button Content="Clear" Width="90" Margin="0,0,10,0" Click="ClearWatches_Click"/>
                        <CheckBox x:Name="WatchesAutoPinCheck" Content="Auto Pin" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox x:Name="WatchesAutoRefreshCheck" Content="Auto Refresh" IsChecked="True" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" x:Name="WatchesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="260"/>
                            <DataGridTextColumn Header="Instance" Binding="{Binding InstanceId}" Width="120"/>
                            <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" Width="220"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" x:Name="WatchesStatusText" Foreground="{DynamicResource PL.TextSecondaryBrush}" Margin="0,6,0,0" Text="Right-click a field/property and choose Watch Value."/>
                </Grid>
            </TabItem>
            <TabItem Header="Patch Manager">
                <local:PatchManagerView Loaded="PatchManagerView_Loaded"/>
            </TabItem>
            <TabItem Header="Logs">
                <local:LogView/>
            </TabItem>
        </TabControl>
        
        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource PL.TextSecondaryBrush}" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="MelonStatusText" Foreground="{DynamicResource PL.TextSecondaryBrush}" Text="IPC: Disconnected"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
